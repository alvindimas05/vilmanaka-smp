---
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import { faDiscord, faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import Layout from "../layouts/Layout.astro";
import iconImage from "../assets/icon.webp";
import backgroundImage from "../assets/background.webp";

library.add(faDiscord, faWhatsapp);

const discordIcon = icon(faDiscord).html[0];
const whatsappIcon = icon(faWhatsapp).html[0];
---

<Layout>
  <main
    class="min-h-screen flex items-center justify-center p-8"
    style={`background-image: url(${backgroundImage.src}); background-size: cover; background-position: center;`}
  >
    <div
      class="max-w-6xl w-full flex flex-col md:flex-row items-stretch gap-12 min-h-[60vh]"
    >
      <!-- Left column -->
      <div class="flex-1 flex flex-col justify-between">
        <div class="flex-1 flex flex-col justify-center">
          <p
            class="text-lg text-white/90 mb-4 max-w-md font-medium leading-relaxed"
          >
            Server berbasis Survival Mix dimana para builder bisa membangun
            dengan tenang.
          </p>
          <div
            class="flex items-center justify-between bg-slate-900/80 backdrop-blur-md rounded-xl border border-slate-700/50 shadow-xl overflow-hidden w-full max-w-md p-4"
          >
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-slate-400 font-sans tracking-wide uppercase">IP Address</span>
              <span
                class="text-xl md:text-2xl font-mono text-slate-200 font-bold tracking-tight mt-1"
              >
                {import.meta.env.VITE_SERVER_ADDRESS}
              </span>
            </div>
            <button
              class="btn btn-square btn-ghost btn-md text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-colors"
              onclick={`navigator.clipboard.writeText("${
                import.meta.env.VITE_SERVER_ADDRESS
              }")`}
              title="Copy IP"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"
                ></rect><path
                  d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path>
              </svg>
            </button>
          </div>

          <div class="flex gap-4 mt-4">
            <a href="#" class="btn btn-primary gap-2">
              <div
                class="size-5 flex items-center justify-center"
                set:html={discordIcon}
              >
              </div>
              Discord
            </a>
            <a href="#" class="btn btn-success gap-2 text-white">
              <div
                class="size-5 flex items-center justify-center"
                set:html={whatsappIcon}
              >
              </div>
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Right column -->
      <div class="flex-1 flex justify-center items-center">
        <!-- SVG icon placeholder -->
        <div
          class="w-80 h-80 lg:w-100 lg:h-100 flex items-center justify-center hover:scale-105 transition-transform duration-300"
        >
          <img src={iconImage.src} alt="Vilmanaka SMP" />
        </div>
      </div>
    </div>
  </main>
</Layout>
