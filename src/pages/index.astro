---
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import { faDiscord, faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import Layout from "../layouts/Layout.astro";
import iconImage from "../assets/images/icon.webp";
import backgroundImage from "../assets/images/background.webp";

library.add(faDiscord, faWhatsapp);

const discordIcon = icon(faDiscord).html[0];
const whatsappIcon = icon(faWhatsapp).html[0];
---

<Layout>
  <main
    class="relative min-h-screen flex items-center justify-center p-8 pt-24 overflow-hidden"
    style={`background-image: url(${backgroundImage.src}); background-size: cover; background-position: center;`}
  >
    <!-- Neon background tint overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(135deg, rgba(191,0,255,0.06) 0%, rgba(3,7,18,0.75) 40%, rgba(0,245,255,0.02) 100%);"
    >
    </div>

    <!-- Ambient orbs -->
    <div
      class="absolute top-1/4 -left-32 w-96 h-96 rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(191,0,255,0.09) 0%, transparent 70%); animation: float 10s ease-in-out infinite;"
    >
    </div>
    <div
      class="absolute bottom-1/4 -right-32 w-96 h-96 rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(0,245,255,0.05) 0%, transparent 70%); animation: float 14s ease-in-out infinite reverse;"
    >
    </div>

    <div
      class="relative z-10 max-w-6xl w-full flex flex-col md:flex-row items-center gap-16 min-h-[60vh]"
    >
      <!-- ── Left Column ── -->
      <div class="flex-1 flex flex-col justify-center gap-6 animate-slide-left">
        <!-- Tag line -->
        <div class="flex items-center gap-3">
          <div
            class="h-px flex-1 max-w-[60px]"
            style="background: linear-gradient(to right, transparent, rgba(191,0,255,0.6));"
          >
          </div>
          <span
            class="font-orbitron text-xs font-semibold tracking-[0.3em] uppercase neon-text-purple"
            >Vilmanaka SMP</span
          >
        </div>

        <!-- Server title -->
        <!-- <h1 class="font-orbitron text-4xl md:text-5xl font-black uppercase leading-tight">
          <span style="color:#e2e8f0;">Vilmanaka</span><br/>
          <span class="neon-text-cyan" style="animation-delay: 0.5s;">SMP</span>
        </h1> -->

        <!-- Description -->
        <div>
          <p
            class="font-rajdhani text-lg text-slate-300/90 max-w-md leading-relaxed"
            style="text-shadow: 0 0 20px rgba(191,0,255,0.15);"
          >
            Server Minecraft <span
              class="neon-text-orange"
              style="animation: none;">Survival Mix</span
            >
            <span class="neon-text-cyan">Java & Bedrock</span> dimana player bisa
            building, explorasi, dan have fun dengan komunitas.
          </p>
        </div>

        <!-- IP Box -->
        <div
          class="glass-panel neon-border-purple rounded-xl overflow-hidden w-full max-w-md animate-fade-up"
          style="animation-delay: 0.3s; opacity: 0;"
        >
          <!-- IP header bar -->
          <div
            class="flex items-center justify-between px-4 py-2 border-b border-purple-500/20"
            style="background: rgba(191,0,255,0.04);"
          >
            <!-- Left: status dot + label -->
            <div class="flex items-center gap-2">
              <div
                id="status-dot"
                class="w-2 h-2 rounded-full"
                style="background: rgba(191,0,255,0.3);"
              >
              </div>
              <span
                id="status-label"
                class="font-orbitron text-[10px] tracking-widest uppercase text-purple-400/60"
                >Checking...</span
              >
            </div>
            <!-- Right: player count -->
            <span
              id="player-count"
              class="font-orbitron text-[10px] tracking-widest uppercase text-purple-300"
            ></span>
          </div>
          <!-- IP content -->
          <div class="flex items-center justify-between px-5 py-4">
            <div class="flex flex-col gap-1">
              <span
                class="font-orbitron text-[10px] tracking-[0.25em] uppercase text-purple-400/80"
                >IP Address</span
              >
              <span
                id="server-ip"
                class="font-tech-mono text-xl md:text-2xl text-purple-300 font-bold tracking-tight"
                style="text-shadow: 0 0 12px rgba(191,0,255,0.6);"
              >
                {import.meta.env.VITE_SERVER_ADDRESS}
              </span>
            </div>
            <button
              id="copy-btn"
              class="relative group flex items-center gap-2 px-4 py-2 rounded-lg font-orbitron text-[10px] tracking-widest uppercase text-purple-400 border border-purple-400/30 bg-purple-400/05 hover:bg-purple-400/15 hover:border-purple-400/70 hover:text-white transition-all duration-300 hover:shadow-[0_0_14px_rgba(191,0,255,0.35)]"
              onclick={`
                navigator.clipboard.writeText("${
                  import.meta.env.VITE_SERVER_ADDRESS
                }");
                const btn = document.getElementById('copy-btn');
                const label = document.getElementById('copy-label');
                if (btn && label) {
                  label.textContent = 'Copied!';
                  btn.style.borderColor = '#00ff88';
                  btn.style.color = '#00ff88';
                  btn.style.boxShadow = '0 0 14px rgba(0,255,136,0.4)';
                  setTimeout(() => {
                    label.textContent = 'Copy';
                    btn.style.borderColor = '';
                    btn.style.color = '';
                    btn.style.boxShadow = '';
                  }, 2000);
                }
              `}
              title="Copy IP"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path
                  d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path>
              </svg>
              <span id="copy-label" class="hidden md:inline">Copy</span>
            </button>
          </div>
        </div>

        <!-- Social buttons -->
        <div
          class="flex gap-3 flex-wrap animate-fade-up"
          style="animation-delay: 0.5s; opacity: 0;"
        >
          <a
            href={import.meta.env.VITE_DISCORD_LINK}
            id="btn-discord"
            class="neon-btn-discord flex items-center gap-2 px-6 py-3 rounded-lg cursor-pointer"
          >
            <span
              class="w-5 h-5 flex items-center justify-center"
              set:html={discordIcon}></span>
            Discord
          </a>
          <a
            href={import.meta.env.VITE_WHATSAPP_LINK}
            id="btn-whatsapp"
            class="neon-btn-green flex items-center gap-2 px-6 py-3 rounded-lg cursor-pointer"
          >
            <span
              class="w-5 h-5 flex items-center justify-center"
              set:html={whatsappIcon}></span>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- ── Right Column ── -->
      <div class="flex-1 flex justify-center items-center animate-slide-right">
        <div class="relative flex items-center justify-center">
          <!-- Icon -->
          <div
            class="w-64 h-64 lg:w-80 lg:h-80 flex items-center justify-center animate-float z-10 relative"
          >
            <img
              src={iconImage.src}
              alt="Vilmanaka SMP"
              class="w-full h-full object-contain"
              style="filter: drop-shadow(0 0 20px rgba(191,0,255,0.45)) drop-shadow(0 0 40px rgba(191,0,255,0.25)) drop-shadow(0 0 80px rgba(0,245,255,0.1));"
            />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ serverAddress: import.meta.env.VITE_SERVER_ADDRESS }}>
  (async () => {
    const dot = document.getElementById("status-dot");
    const label = document.getElementById("status-label");
    const playerCount = document.getElementById("player-count");
    try {
      const res = await fetch(`https://api.mcsrvstat.us/3/${serverAddress}`);
      const data = await res.json();
      if (data.online) {
        dot.style.background = "#00ff88";
        dot.style.boxShadow = "0 0 6px #00ff88";
        label.textContent = "Online";
        label.style.color = "#00ff88";
        const online = data.players?.online ?? 0;
        const max = data.players?.max ?? 0;
        playerCount.textContent = `${online} / ${max} Players`;
      } else {
        dot.style.background = "#ff4444";
        dot.style.boxShadow = "0 0 6px #ff4444";
        label.textContent = "Offline";
        label.style.color = "#ff4444";
        playerCount.textContent = "";
      }
    } catch {
      dot.style.background = "#ff4444";
      dot.style.boxShadow = "0 0 6px #ff4444";
      label.textContent = "Offline";
      label.style.color = "#ff4444";
      playerCount.textContent = "";
    }
  })();
</script>
